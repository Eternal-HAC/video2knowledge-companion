{
	"schemaVersion": "0.1.0",
	"name": "Video2Knowledge YouTube Companion",
	"behavior": "create",
	"noteContentFormat": "# {{title}}\n\n[Watch on YouTube]({{url}})\n\n> [!info] Transcript\n> In Obsidian, run **Insert YouTube transcript** to fetch or refresh the transcript safely.\n\n## Description\n\n{{description}}\n\n## Notes\n\n",
	"properties": [
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "channel",
			"value": "{{author}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{published|date:\"YYYY-MM-DD\"}}",
			"type": "date"
		},
		{
			"name": "captured",
			"value": "{{time|date:\"YYYY-MM-DDTHH:mm:ssZ\"}}",
			"type": "datetime"
		},
		{
			"name": "tags",
			"value": "video/youtube",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://www.youtube.com/watch",
		"https://m.youtube.com/watch",
		"https://youtu.be/"
	],
	"noteNameFormat": "{{title|safe_name|trim}}",
	"path": ""
}
