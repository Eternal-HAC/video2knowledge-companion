{
	"name": "video2knowledge-companion",
	"version": "0.6.0",
	"description": "Capture video transcripts and connect notes to a local Video2Knowledge service.",
	"main": "main.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Eternal-HAC/video2knowledge-companion.git"
	},
	"homepage": "https://github.com/Eternal-HAC/video2knowledge-companion#readme",
	"bugs": {
		"url": "https://github.com/Eternal-HAC/video2knowledge-companion/issues"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs",
		"test": "jest",
		"lint": "eslint src tests",
		"check-format": "prettier --check src tests",
		"format": "prettier --write src tests",
		"validate-release": "node scripts/validate-release.mjs"
	},
	"keywords": [
		"obsidian",
		"youtube",
		"bilibili",
		"transcript",
		"video2knowledge"
	],
	"author": "Eternal-HAC",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.6.0",
		"builtin-modules": "^5.1.0",
		"esbuild": "^0.28.0",
		"eslint": "^10.2.1",
		"jest": "^30.3.0",
		"obsidian": "^1.12.3",
		"prettier": "^3.8.3",
		"ts-jest": "^29.4.9",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0"
	}
}
